# Copy to /etc/hypermesh/aiuditor-witness.env and chmod 0600.
# Same image as Azure global. This process cannot fulfill a market grant.

AIUDITOR_ROLE=witness
HOST=127.0.0.1
PORT=8015

# Global AIuditor (test plane). Not hyperme.sh. Path prefix /api/v1/aiuditor.
AIUDITOR_PARENT_URL=https://api.test.hyperme.sh
AIUDITOR_PARENT_TOKEN=
AIUDITOR_HYDRATE_TENANT_ID=
AIUDITOR_HYDRATE_EVERY=60

# Omit DATABASE_URL. Witness persist is the hydrated copy in memory.
# PANOPTICON_IMAGE_TAG=test
# SERVICE_NAME=aiuditor-witness
